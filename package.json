{
  "name": "dsh-vsing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual singer workbench skeleton: project file, lyric axis, note draft, export, local HTTP API, agent tools.",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
